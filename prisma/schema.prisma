generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Application {
  id                 String   @id @default(uuid()) @db.Uuid
  receivedAt         DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  role               String
  firstName          String   @map("first_name")
  lastName           String   @map("last_name")
  email              String
  fullAddress        String?  @map("full_address")
  phone              String?
  internetProvider   String?  @map("internet_provider")
  downloadSpeed      Int?     @map("download_speed")
  uploadSpeed        Int?     @map("upload_speed")
  secureLocation     String?  @map("secure_location")
  availability       String?
  portfolio          String?
  linkedin           String?
  message            String?
  resumeOriginalName String?  @map("resume_original_name")
  consent            Boolean  @default(true)
  status             String   @default("unread")

  @@index([receivedAt])
  @@index([email])
  @@map("applications")
}
